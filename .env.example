SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos: SQL Server ---
DB_NAME=sistema_reservaciones
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server

# Opcion A) Autenticacion SQL (usuario y contrasena de SQL Server):
DB_USER=sa
DB_PASSWORD=tu_password

# Opcion B) Autenticacion de Windows (Windows Authentication):
# Deja DB_USER y DB_PASSWORD vacios y el sistema usara tu sesion de Windows.
# DB_USER=
# DB_PASSWORD=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion

LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15

# --- Correos (bienvenida y notificaciones de reservas) ---
# Sin estas lineas los correos se imprimen en la terminal (modo consola).
# Para enviarlos de verdad, descomenta y llena:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_de_16_letras
